{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "dry_run": true,
  "dry_run_wallet": 1000,
  "cancel_open_orders_on_exit": true,
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "liquidation_buffer": 0.05,
  "futures_funding_rate": 0.0,
  "stake_currency": "USDT",
  "stake_amount": 50,
  "tradable_balance_ratio": 0.95,
  "fiat_display_currency": "USD",
  "max_open_trades": 2,
  "timeframe": "5m",
  "process_only_new_candles": true,
  "dataformat_ohlcv": "parquet",
  "dataformat_trades": "parquet",
  "exchange": {
    "name": "binance",
    "key": "",
    "secret": "",
    "ccxt_config": {
      "enableRateLimit": true,
      "options": {
        "defaultType": "swap"
      }
    },
    "ccxt_async_config": {
      "enableRateLimit": true,
      "options": {
        "defaultType": "swap"
      }
    },
    "pair_whitelist": [
      "BTC/USDT:USDT",
      "ETH/USDT:USDT"
    ],
    "pair_blacklist": []
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0.0,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 1
    }
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0.0
  },
  "order_types": {
    "entry": "limit",
    "exit": "limit",
    "emergency_exit": "market",
    "force_entry": "market",
    "force_exit": "market",
    "stoploss": "market",
    "stoploss_on_exchange": false
  },
  "order_time_in_force": {
    "entry": "GTC",
    "exit": "GTC"
  },
  "unfilledtimeout": {
    "entry": 10,
    "exit": 10,
    "exit_timeout_count": 0,
    "unit": "minutes"
  },
  "minimal_roi": {
    "0": 0.02
  },
  "stoploss": -0.015,
  "use_exit_signal": true,
  "exit_profit_only": false,
  "exit_profit_offset": 0.0,
  "ignore_roi_if_entry_signal": false,
  "ignore_buying_expired_candle_after": 0,
  "position_adjustment_enable": false,
  "force_entry_enable": false,
  "disable_dataframe_checks": false,
  "telegram": {
    "enabled": false,
    "token": "",
    "chat_id": ""
  },
  "api_server": {
    "enabled": false,
    "listen_ip_address": "127.0.0.1",
    "listen_port": 8080,
    "username": "smartcrypto",
    "password": "smartcrypto-paper-disabled",
    "ws_token": "smartcrypto-paper-ws-token-disabled-change-before-enable",
    "jwt_secret_key": "smartcrypto-paper-jwt-secret-disabled-change-before-enable",
    "CORS_origins": [],
    "verbosity": "error"
  },
  "bot_name": "smartcrypto-paper",
  "initial_state": "running",
  "internals": {
    "process_throttle_secs": 5,
    "heartbeat_interval": 60
  }
}
